diff --git a/cc2-control/web-src/preview/test-canvas-states.mjs b/cc2-control/web-src/preview/test-canvas-states.mjs
new file mode 100644
index 0000000..614b503
--- /dev/null
+++ b/cc2-control/web-src/preview/test-canvas-states.mjs
@@ -0,0 +1,55 @@
+import assert from 'node:assert/strict'
+import { chromium } from 'playwright'
+import { fixture, launchOptions } from './fixture.mjs'
+
+const demo = await fixture()
+const browser = await chromium.launch(launchOptions)
+try {
+  const page = await browser.newPage({ viewport: { width: 1440, height: 1000 } })
+  await page.addInitScript(() => localStorage.setItem('cc2-fixture-preferences', '{"language":"en"}'))
+  await page.goto(demo.url + '#canvas')
+  const load = page.locator('[data-canvas-action="canvas.load"]')
+  const unload = page.locator('[data-canvas-action="canvas.unload"]')
+  const card = slot => page.locator(`[data-canvas-slot="${slot}"]`)
+  await load.waitFor()
+  assert.equal(await load.isDisabled(), true)
+  assert.equal(await unload.isDisabled(), true)
+  await card(0).getByText('Empty', { exact: true }).waitFor()
+  await card(1).getByRole('button', { name: 'Select slot', exact: true }).click()
+  assert.equal(await load.isDisabled(), false)
+  assert.equal(await unload.isDisabled(), true)
+  await card(1).getByText('Present · unloaded from head', { exact: true }).waitFor()
+  await page.evaluate(() => {
+    Object.assign(window.__CC2_PREVIEW, { activeTray: 1, headLoaded: true })
+    window.__CC2_PREVIEW.trays[1].status = 2
+  })
+  await card(1).getByText('Loaded to head', { exact: true }).waitFor()
+  assert.equal(await load.isDisabled(), true)
+  assert.equal(await unload.isDisabled(), false)
+  await card(2).getByRole('button', { name: 'Select slot', exact: true }).click()
+  assert.equal(await load.isDisabled(), true, 'another loaded channel prevents loading')
+  assert.equal(await unload.isDisabled(), true, 'only the loaded channel can unload')
+  await page.evaluate(() => { window.__CC2_PREVIEW.headLoaded = false })
+  await card(2).getByText('Transition · waiting for confirmation', { exact: true }).waitFor()
+  assert.equal(await load.isDisabled(), true)
+  await page.evaluate(() => { window.__CC2_PREVIEW.activeTray = -1 })
+  await page.waitForFunction(() => !document.querySelector('[data-canvas-action="canvas.load"]').disabled)
+  await page.evaluate(() => { window.__CC2_PREVIEW.status = 2 })
+  await page.waitForFunction(() => document.querySelector('[data-canvas-action="canvas.load"]').disabled)
+  await page.evaluate(() => { window.__CC2_PREVIEW.status = 1; window.__CC2_PREVIEW.canvasFresh = false })
+  await card(2).getByText('State unavailable', { exact: true }).waitFor()
+  assert.equal(await load.isDisabled(), true)
+  assert.equal(await unload.isDisabled(), true)
+  assert.deepEqual(await page.evaluate(() => window.__CC2_PREVIEW.commands), [], 'state changes and disabled actions send no commands')
+  for (const width of [1440, 768, 390]) {
+    await page.setViewportSize({ width, height: 1000 })
+    await page.waitForTimeout(200)
+    const overflow = await page.evaluate(() => ({ width: innerWidth, scroll: document.documentElement.scrollWidth,
+      elements: [...document.querySelectorAll('main *')].filter(e => e.getBoundingClientRect().right > innerWidth + 1).slice(0, 8).map(e => [e.tagName, e.className, e.textContent.slice(0, 70)]) }))
+    assert(overflow.scroll <= overflow.width, JSON.stringify(overflow))
+  }
+  console.log('PASS: Canvas slot state and action eligibility across empty, parked, loaded, other channel, transition, print and unavailable state')
+} finally {
+  await browser.close()
+  await demo.cleanup()
+}
diff --git a/cc2-control/web-src/preview/test-control-interactions.mjs b/cc2-control/web-src/preview/test-control-interactions.mjs
new file mode 100644
index 0000000..e53db96
--- /dev/null
+++ b/cc2-control/web-src/preview/test-control-interactions.mjs
@@ -0,0 +1,68 @@
+import assert from 'node:assert/strict'
+import { chromium } from 'playwright'
+import { fixture, launchOptions } from './fixture.mjs'
+
+const demo = await fixture()
+const browser = await chromium.launch(launchOptions)
+try {
+  const page = await browser.newPage({ viewport: { width: 1440, height: 1000 } })
+  await page.addInitScript(() => {
+    if (!localStorage.getItem('cc2-fixture-preferences'))
+      localStorage.setItem('cc2-fixture-preferences', '{"language":"en","theme":"dark"}')
+  })
+  const errors = []
+  page.on('pageerror', e => errors.push(e.message))
+  if (process.env.CC2_TEST_CASE !== 'camera') {
+    await page.goto(demo.url + '#control')
+    const range = page.locator('.cc2-fans input[type=range]').first()
+    await range.waitFor()
+    const box = await range.boundingBox()
+    assert(box)
+    await page.mouse.move(box.x + 8, box.y + box.height / 2)
+    await page.mouse.down()
+    await page.mouse.move(box.x + box.width * 0.8, box.y + box.height / 2, { steps: 12 })
+    await page.evaluate(() => { window.__CC2_PREVIEW.fans.part = 15 })
+    await page.waitForTimeout(1800)
+    assert.equal(await range.isDisabled(), false, 'slider must remain enabled during a held mouse drag')
+    assert.equal((await page.evaluate(() => window.__CC2_PREVIEW.commands)).length, 0, 'mouse drag must not commit before release')
+    const draft = Number(await range.inputValue())
+    assert(draft >= 65, 'telemetry must not reset the dragged thumb')
+    await page.mouse.up()
+    await page.waitForFunction(() => window.__CC2_PREVIEW.commands.length === 1)
+    assert.deepEqual(await page.evaluate(() => window.__CC2_PREVIEW.commands), [`fan:part:${draft}`])
+    console.log('PASS: held mouse drag survives telemetry and commits exactly once on release')
+  }
+  if (process.env.CC2_TEST_CASE !== 'fans') {
+    for (const width of [1440, 1920, 768, 390]) {
+      await page.setViewportSize({ width, height: 1000 })
+      const dimensions = async route => {
+        await page.goto(demo.url + '#' + route)
+        const frame = page.locator('.cc2-camera-frame').first()
+        await frame.waitFor()
+        await page.waitForTimeout(400)
+        return { frame: await frame.boundingBox(), card: await frame.locator('..').boundingBox() }
+      }
+      await page.goto(demo.url + '#settings')
+      await page.getByRole('tab', { name: 'Appearance', exact: true }).click()
+      const flag = page.getByRole('checkbox', { name: 'Keep live camera across pages' })
+      await flag.uncheck()
+      const before = {}
+      for (const route of ['dashboard', 'job']) before[route] = await dimensions(route)
+      await page.goto(demo.url + '#settings')
+      await page.getByRole('tab', { name: 'Appearance', exact: true }).click()
+      await flag.check()
+      for (const route of ['dashboard', 'job']) {
+        const after = await dimensions(route)
+        for (const element of ['frame', 'card']) for (const side of ['width', 'height']) {
+          assert(Math.abs(before[route][element][side] - after[element][side]) <= 1,
+            `${route}/${width} persistent ${element} ${side}: ${before[route][element][side]} -> ${after[element][side]}`)
+        }
+      }
+    }
+    console.log('PASS: persistent camera preserves normal card/frame dimensions on dashboard/job at four viewport widths')
+  }
+  assert.deepEqual(errors, [])
+} finally {
+  await browser.close()
+  await demo.cleanup()
+}
